# ====================================================================
# PHYSICS MOTION MECHANICS SANDBOX - ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and populate the values below
# ====================================================================

# 1. Supabase PostgreSQL Persistence & Authentication
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 2. Google Gemini API (Server-side AI Physics Tutor)
# Obtain a free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: Specific Gemini model override (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
